        },
        {
          "id": "f5bf043e-1f2a-405d-a512-8e797e6b162a",
          "comment": "",
          "command": "executeScript",
          "target": "var el = document.getElementById('user-name'); var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; setter.call(el, 'standard_user'); el.dispatchEvent(new Event('input', { bubbles: true }));",
          "targets": [],
          "value": ""
        },
        {
          "id": "0476fec7-5346-4f5c-8b22-b717fae912e1",
          "comment": "",
          "command": "executeScript",
          "target": "var el = document.getElementById('password'); var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; setter.call(el, 'secret_sauce'); el.dispatchEvent(new Event('input', { bubbles: true }));",
