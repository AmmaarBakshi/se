<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="STQA TestNG Suite" verbose="1">

  <test name="Smoke Tests">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="com.stqa.tests.SmokeAndRegressionTests"/>
    </classes>
  </test>

  <test name="Regression Tests">
    <groups>
      <run>
        <include name="regression"/>
      </run>
    </groups>
    <classes>
      <class name="com.stqa.tests.SmokeAndRegressionTests"/>
    </classes>
  </test>

</suite>
